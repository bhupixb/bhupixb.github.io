---
import { SITE, SOCIALS } from "@consts"
---

<footer>
  <p class="socials">
    {SOCIALS.map((social) => (
      <a href={social.HREF} rel={social.HREF.startsWith("http") ? "me noreferrer" : undefined}>
        {social.NAME}
      </a>
    ))}
    <a href="/rss.xml">RSS</a>
  </p>
  <p>&copy; {new Date().getFullYear()} {SITE.AUTHOR}</p>
</footer>
