---
import "@styles/global.css"
import BaseHead from "@components/BaseHead.astro"
import Header from "@components/Header.astro"
import Footer from "@components/Footer.astro"
import Drawer from "@components/Drawer.astro"
import { SITE } from "@consts"

type Props = {
  title: string
  description: string
  image?: string
  socialTitle?: string
  type?: "website" | "article"
}

const { title, description, image, socialTitle = title, type } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${title} | ${SITE.TITLE}`} socialTitle={socialTitle} description={description} image={image} type={type} />
  </head>
  <body>
    <Header />
    <Drawer />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
