---
import { type CollectionEntry, getCollection } from "astro:content"

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">
}

// Get the requested entry
const { entry } = Astro.props
const { collection } = entry
const { Content } = await entry.render()

// Get the next and prev entries (modulo to wrap index)
const items = (await getCollection(collection))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
const index = items.findIndex(x => x.slug === entry.slug)
const prev = items[(index - 1 + items.length) % items.length]
const next = items[(index + 1) % items.length]
---

<div>
  <article>
    <Content/>
  </article>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <a href={`/${prev.collection}/${prev.slug}`} class="editorial-card editorial-card-hover group flex items-center gap-3 p-5">
      <div class="order-2 h-full w-full transition-colors duration-300 ease-in-out group-hover:text-zinc-950 dark:group-hover:text-ink-100">
        <div class="flex flex-wrap gap-2">
          <div class="text-xs font-semibold uppercase tracking-[0.14em] text-zinc-500 dark:text-ink-300">
            Prev
          </div>
        </div>
        <div class="mt-3 font-display font-semibold tracking-normal text-zinc-950 dark:text-ink-100">
          {prev.data.title}
        </div>
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="order-1 shrink-0 rotate-180 stroke-current text-zinc-400 transition-colors duration-300 ease-in-out group-hover:text-sky-600 dark:text-ink-300 dark:group-hover:text-accent-sky">
        <line x1="5" y1="12" x2="19" y2="12" class="scale-x-0 group-hover:scale-x-100 translate-x-4 group-hover:translate-x-1 transition-all duration-300 ease-in-out" />
        <polyline points="12 5 19 12 12 19" class="translate-x-0 group-hover:translate-x-1 transition-all duration-300 ease-in-out" />
      </svg>
    </a>
    <a href={`/${next.collection}/${next.slug}`} class="editorial-card editorial-card-hover group flex items-center gap-3 p-5">
      <div class="h-full w-full text-right transition-colors duration-300 ease-in-out group-hover:text-zinc-950 dark:group-hover:text-ink-100">
        <div class="text-xs font-semibold uppercase tracking-[0.14em] text-zinc-500 dark:text-ink-300">
          Next
        </div>
        <div class="mt-3 font-display font-semibold tracking-normal text-zinc-950 dark:text-ink-100">
          {next.data.title}
        </div>
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 stroke-current text-zinc-400 transition-colors duration-300 ease-in-out group-hover:text-sky-600 dark:text-ink-300 dark:group-hover:text-accent-sky">
        <line x1="5" y1="12" x2="19" y2="12" class="scale-x-0 group-hover:scale-x-100 translate-x-4 group-hover:translate-x-1 transition-all duration-300 ease-in-out" />
        <polyline points="12 5 19 12 12 19" class="translate-x-0 group-hover:translate-x-1 transition-all duration-300 ease-in-out" />
      </svg>
    </a>
  </div>
</div>
