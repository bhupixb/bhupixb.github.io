---
import { getCollection, render } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import { WORK } from "@consts"
import { formatMonthYear } from "@lib/utils"

const entries = (await getCollection("work"))
  .sort((a, b) => b.data.dateStart.getTime() - a.data.dateStart.getTime())

const work = await Promise.all(
  entries.map(async (entry) => ({ ...entry, Content: (await render(entry)).Content }))
)
---

<PageLayout title={WORK.TITLE} description={WORK.DESCRIPTION}>
  <h1>{WORK.TITLE}</h1>
  {work.map((entry) => (
    <section class="job">
      <h2>{entry.data.company}</h2>
      <p class="job-meta">
        {entry.data.role && <>{entry.data.role} · </>}
        {formatMonthYear(entry.data.dateStart)} – {formatMonthYear(entry.data.dateEnd)}
      </p>
      <entry.Content />
    </section>
  ))}
</PageLayout>
