---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import { SITE, SOCIALS } from "@consts"
import { formatDate, readingTime } from "@lib/utils"

const posts = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)

const skills = ["Java", "Spring Boot", "PostgreSQL", "Kubernetes", "Docker", "AWS", "Flink", "OpenAPI"]

const workAreas = [
  {
    title: "Backend Engineering",
    text: "Java, Spring Boot, REST APIs, service design, OpenAPI",
  },
  {
    title: "Infrastructure",
    text: "Docker, Kubernetes, Helm, ArgoCD, CI/CD",
  },
  {
    title: "Data & Streaming",
    text: "Flink, Airflow, Trino, production data jobs",
  },
  {
    title: "Security Curiosity",
    text: "Android, networking, web security, practical debugging notes",
  },
]

const stackGroups = [
  {
    title: "Languages",
    items: ["Java", "Python", "Bash", "C++"],
  },
  {
    title: "Backend",
    items: ["Spring Boot", "REST", "OpenAPI", "PostgreSQL"],
  },
  {
    title: "Infrastructure",
    items: ["Docker", "Kubernetes", "Helm", "ArgoCD", "Jenkins"],
  },
  {
    title: "Data",
    items: ["Flink", "Airflow", "Trino"],
  },
]
---

<PageLayout title="Home" description={SITE.DESCRIPTION}>
  <div class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[34rem] bg-[radial-gradient(circle_at_50%_0%,rgba(56,189,248,0.18),transparent_36rem)] dark:bg-[radial-gradient(circle_at_50%_0%,rgba(56,189,248,0.18),transparent_38rem)]"></div>

    <section class="relative mx-auto flex min-h-[92vh] w-full max-w-screen-xl flex-col justify-center px-5 pb-16 pt-28 md:pb-24 md:pt-36">
      <div class="max-w-4xl">
        <p class="mb-5 inline-flex rounded-full border border-sky-400/30 bg-sky-400/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-sky-700 dark:text-accent-sky">
          Bhupendra Yadav
        </p>
        <h1 class="font-display text-5xl font-semibold tracking-normal text-zinc-950 dark:text-ink-100 sm:text-6xl lg:text-7xl">
          Backend & Infrastructure Engineer
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-700 dark:text-ink-300">
          I build reliable backend systems, Kubernetes platforms, and production-grade Java services. I write about backend engineering, infrastructure, distributed systems, and practical software craftsmanship.
        </p>
      </div>

      <div class="mt-8 flex flex-wrap gap-2">
        {skills.map((skill) => (
          <span class="rounded-full border border-black/10 bg-white/70 px-3 py-1 text-sm font-medium text-zinc-800 dark:border-white/10 dark:bg-white/5 dark:text-ink-100">
            {skill}
          </span>
        ))}
      </div>

      <div class="mt-10 flex flex-wrap gap-3">
        <a href="/blog" class="rounded-md bg-zinc-950 px-5 py-3 text-sm font-semibold text-white transition hover:bg-zinc-800 dark:bg-ink-100 dark:text-ink-950 dark:hover:bg-white">
          Read technical notes
        </a>
        <a href="/projects" class="rounded-md border border-black/15 bg-white/70 px-5 py-3 text-sm font-semibold text-zinc-950 transition hover:border-sky-400/50 hover:bg-white dark:border-white/15 dark:bg-white/5 dark:text-ink-100 dark:hover:border-accent-sky/50 dark:hover:bg-white/10">
          View projects
        </a>
        <a href="https://github.com/bhupixb" target="_blank" rel="noreferrer" class="rounded-md border border-black/15 px-5 py-3 text-sm font-semibold text-zinc-950 transition hover:border-sky-400/50 hover:bg-white/80 dark:border-white/15 dark:text-ink-100 dark:hover:border-accent-sky/50 dark:hover:bg-white/10">
          GitHub
        </a>
      </div>

      <div class="mt-16 grid gap-3 border-l border-black/10 pl-5 text-sm text-zinc-600 dark:border-white/10 dark:text-ink-300 sm:grid-cols-3 sm:border-l-0 sm:pl-0">
        <div>
          <div class="font-semibold text-zinc-950 dark:text-ink-100">Systems</div>
          <div>Backend services, APIs, and data contracts.</div>
        </div>
        <div>
          <div class="font-semibold text-zinc-950 dark:text-ink-100">Platforms</div>
          <div>Kubernetes, delivery pipelines, and operations.</div>
        </div>
        <div>
          <div class="font-semibold text-zinc-950 dark:text-ink-100">Writing</div>
          <div>Practical notes from debugging and production work.</div>
        </div>
      </div>
    </section>

    <div class="relative mx-auto max-w-screen-xl space-y-24 px-5 pb-20">
      <section class="animate">
        <div class="mb-8 max-w-2xl">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-sky-700 dark:text-accent-sky">Focus</p>
          <h2 class="mt-3 font-display text-3xl font-semibold tracking-normal text-zinc-950 dark:text-ink-100">What I work on</h2>
        </div>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          {workAreas.map((area) => (
            <div class="editorial-card editorial-card-hover p-5">
              <h3 class="font-display text-lg font-semibold text-zinc-950 dark:text-ink-100">{area.title}</h3>
              <p class="mt-3 text-sm leading-6 text-zinc-600 dark:text-ink-300">{area.text}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="animate">
        <div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.16em] text-sky-700 dark:text-accent-sky">Writing</p>
            <h2 class="mt-3 font-display text-3xl font-semibold tracking-normal text-zinc-950 dark:text-ink-100">Recent technical notes</h2>
          </div>
          <a href="/blog" class="text-sm font-semibold text-zinc-950 underline decoration-black/20 underline-offset-4 transition hover:decoration-sky-500 dark:text-ink-100 dark:decoration-white/20 dark:hover:decoration-accent-sky">
            All posts
          </a>
        </div>
        <div class="grid gap-4 lg:grid-cols-3">
          {posts.map((post) => (
            <a href={`/blog/${post.slug}`} class="editorial-card editorial-card-hover group flex min-h-64 flex-col p-5">
              <div class="flex flex-wrap items-center gap-3 text-xs font-semibold uppercase tracking-[0.12em] text-zinc-500 dark:text-ink-300">
                <span>{formatDate(post.data.date)}</span>
                <span class="h-1 w-1 rounded-full bg-zinc-300 dark:bg-white/30"></span>
                <span>{readingTime(post.body)}</span>
              </div>
              <h3 class="mt-5 font-display text-xl font-semibold tracking-normal text-zinc-950 transition group-hover:text-sky-700 dark:text-ink-100 dark:group-hover:text-accent-sky">
                {post.data.title}
              </h3>
              <p class="mt-3 line-clamp-3 text-sm leading-6 text-zinc-600 dark:text-ink-300">
                {post.data.summary}
              </p>
              <ul class="mt-auto flex flex-wrap gap-2 pt-6">
                {post.data.tags.slice(0, 3).map((tag) => (
                  <li class="rounded-full bg-black/5 px-2.5 py-1 text-xs font-medium text-zinc-700 dark:bg-white/10 dark:text-ink-300">
                    {tag}
                  </li>
                ))}
              </ul>
            </a>
          ))}
        </div>
      </section>

      <section class="animate">
        <div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.16em] text-sky-700 dark:text-accent-sky">Projects</p>
            <h2 class="mt-3 font-display text-3xl font-semibold tracking-normal text-zinc-950 dark:text-ink-100">Recent project work</h2>
          </div>
          <a href="/projects" class="text-sm font-semibold text-zinc-950 underline decoration-black/20 underline-offset-4 transition hover:decoration-sky-500 dark:text-ink-100 dark:decoration-white/20 dark:hover:decoration-accent-sky">
            All projects
          </a>
        </div>
        <div class="grid gap-4 lg:grid-cols-3">
          {projects.map((project) => (
            <a href={`/projects/${project.slug}`} class="editorial-card editorial-card-hover group flex min-h-56 flex-col p-5">
              <div class="text-xs font-semibold uppercase tracking-[0.12em] text-zinc-500 dark:text-ink-300">
                {formatDate(project.data.date)}
              </div>
              <h3 class="mt-5 font-display text-xl font-semibold tracking-normal text-zinc-950 transition group-hover:text-sky-700 dark:text-ink-100 dark:group-hover:text-accent-sky">
                {project.data.title}
              </h3>
              <p class="mt-3 line-clamp-3 text-sm leading-6 text-zinc-600 dark:text-ink-300">
                {project.data.summary}
              </p>
              <ul class="mt-auto flex flex-wrap gap-2 pt-6">
                {project.data.tags.slice(0, 3).map((tag) => (
                  <li class="rounded-full bg-black/5 px-2.5 py-1 text-xs font-medium text-zinc-700 dark:bg-white/10 dark:text-ink-300">
                    {tag}
                  </li>
                ))}
              </ul>
            </a>
          ))}
        </div>
      </section>

      <section class="animate grid gap-6 lg:grid-cols-[0.8fr_1.2fr]">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-sky-700 dark:text-accent-sky">Stack</p>
          <h2 class="mt-3 font-display text-3xl font-semibold tracking-normal text-zinc-950 dark:text-ink-100">Tools I reach for</h2>
          <p class="mt-4 leading-7 text-zinc-600 dark:text-ink-300">
            A practical mix for backend services, platform work, automation, and data systems.
          </p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {stackGroups.map((group) => (
            <div class="editorial-card p-5">
              <h3 class="font-display text-lg font-semibold text-zinc-950 dark:text-ink-100">{group.title}</h3>
              <div class="mt-4 flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <span class="rounded-md border border-black/10 bg-black/[0.03] px-2.5 py-1 text-sm text-zinc-700 dark:border-white/10 dark:bg-white/5 dark:text-ink-300">
                    {item}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="animate editorial-card p-6 md:p-8">
        <div class="flex flex-col justify-between gap-8 lg:flex-row lg:items-end">
          <div class="max-w-2xl">
            <p class="text-sm font-semibold uppercase tracking-[0.16em] text-sky-700 dark:text-accent-sky">Contact</p>
            <h2 class="mt-3 font-display text-3xl font-semibold tracking-normal text-zinc-950 dark:text-ink-100">Let us talk backend systems</h2>
            <p class="mt-4 leading-7 text-zinc-600 dark:text-ink-300">
              Reach out for engineering conversations, technical writing, infrastructure problems, or backend architecture notes.
            </p>
          </div>
          <div class="flex flex-wrap gap-2">
            {SOCIALS.map((social) => (
              <a href={social.HREF} target={social.HREF.startsWith("http") ? "_blank" : undefined} rel={social.HREF.startsWith("http") ? "noreferrer" : undefined} class="rounded-md border border-black/10 bg-white/70 px-3 py-2 text-sm font-medium text-zinc-800 transition hover:border-sky-400/50 hover:text-zinc-950 dark:border-white/10 dark:bg-white/5 dark:text-ink-300 dark:hover:border-accent-sky/50 dark:hover:text-ink-100">
                {social.NAME}
              </a>
            ))}
          </div>
        </div>
      </section>
    </div>
  </div>
</PageLayout>
