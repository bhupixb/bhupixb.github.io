---
import PageLayout from "@layouts/PageLayout.astro"
import PostList from "@components/PostList.astro"
import { Content as Bio } from "@content/home.md"
import { SITE } from "@consts"
import { getPublished } from "@lib/content"

const posts = (await getPublished("blog")).slice(0, 5)
---

<PageLayout description={SITE.DESCRIPTION}>
  <h1>Hi, I'm Bhupendra</h1>
  <p class="subtitle">Software engineer / backend &amp; infrastructure</p>

  <Bio />

  <h2>Recent writing</h2>
  <PostList posts={posts} />
  <p><a href="/blog">All posts</a></p>

  <p>You can reach me at <a href="mailto:engineerbhupixb@gmail.com">engineerbhupixb@gmail.com</a>.</p>
</PageLayout>
