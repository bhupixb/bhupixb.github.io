---
// Lists the standalone HTML pages in public/explainer/. Astro copies those files to
// /explainer/<file>.html untouched; this page reads their <title> and <meta> tags at
// build time, so adding an explainer is just dropping an .html file in that folder.
//
// Tags each explainer can set in its <head>:
//   <title>…</title>
//   <meta name="description" content="…">
//   <meta name="note:date" content="YYYY-MM-DD">
//   <meta name="note:tags" content="gcp, networking">
// Each explainer also links the site favicon and keeps its own theme.
// Full steps: .claude/skills/explainer/SKILL.md
import fs from "node:fs"
import path from "node:path"
import PageLayout from "@layouts/PageLayout.astro"
import { EXPLAINERS } from "@consts"

type Note = { href: string; title: string; description: string; date: string; tags: string[] }

const dir = path.join(process.cwd(), "public", "explainer")
const unescape = (text: string) =>
  text
    .replace(/&amp;/g, "&")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
const meta = (html: string, name: string) =>
  unescape(html.match(new RegExp(`<meta\\s+name="${name}"\\s+content="([^"]*)"`, "i"))?.[1] ?? "")

const notes: Note[] = (fs.existsSync(dir) ? fs.readdirSync(dir) : [])
  .filter((file) => file.endsWith(".html"))
  .map((file) => {
    const html = fs.readFileSync(path.join(dir, file), "utf8")
    const fallbackDate = fs.statSync(path.join(dir, file)).mtime.toISOString().slice(0, 10)
    return {
      href: `/explainer/${file}`,
      title: unescape(html.match(/<title>([^<]*)<\/title>/i)?.[1]?.trim() || file.replace(/\.html$/, "")),
      description: meta(html, "description"),
      date: meta(html, "note:date") || fallbackDate,
      tags: meta(html, "note:tags").split(",").map((tag) => tag.trim()).filter(Boolean),
    }
  })
  .sort((a, b) => b.date.localeCompare(a.date))

const shortDate = (date: string) =>
  new Intl.DateTimeFormat("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" }).format(
    new Date(`${date}T00:00:00Z`)
  )
---

<PageLayout title={EXPLAINERS.TITLE} description={EXPLAINERS.DESCRIPTION}>
  <h1>{EXPLAINERS.TITLE}</h1>
  <p class="subtitle">{EXPLAINERS.DESCRIPTION}</p>

  {notes.length === 0 ? (
    <p>No explainers yet.</p>
  ) : (
    <ol class="notes-list">
      {notes.map((note) => (
        <li>
          <time datetime={note.date}>{shortDate(note.date)}</time>
          <div>
            <a href={note.href}>{note.title}</a>
            {note.tags.length > 0 && <p class="note-tags">{note.tags.join(" · ")}</p>}
            {note.description && <p class="note-desc">{note.description}</p>}
          </div>
        </li>
      ))}
    </ol>
  )}
</PageLayout>

<style>
  .notes-list {
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .notes-list li {
    display: flex;
    gap: 1.25rem;
    margin-bottom: 1.4rem;
  }

  .notes-list time {
    width: 6.5rem;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--muted);
  }

  .notes-list p {
    margin: 0;
  }

  .note-tags {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .note-desc {
    font-size: 0.95rem;
  }

  @media (max-width: 520px) {
    .notes-list li {
      display: block;
    }

    .notes-list time {
      display: block;
    }
  }
</style>
