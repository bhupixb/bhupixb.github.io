{"version": 2, "width": 110, "height": 15, "duration": 31.25, "title": "Different names, sequential scans, SERIALIZABLE failure (edited replay)", "env": {"TERM": "xterm-256color"}}
[0.25, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;1H\u001b[1;36mSESSION 1\u001b[0m\u001b[1;57H\u001b[1;35mSESSION 2\u001b[0m\u001b[2;1H\u001b[0m------------------------------------------------------\u001b[0m\u001b[2;57H\u001b[0m------------------------------------------------------\u001b[0m\u001b[2;55H\u2502\u001b[3;55H\u2502\u001b[4;55H\u2502\u001b[5;55H\u2502\u001b[6;55H\u2502\u001b[7;55H\u2502\u001b[8;55H\u2502\u001b[9;55H\u2502\u001b[10;55H\u2502\u001b[11;55H\u2502\u001b[12;55H\u2502\u001b[13;55H\u2502\u001b[14;1H\u001b[1;33mBoth transactions read before either writes.\u001b[0m"]
[1.25, "o", "\u001b[3;1H\u001b[1;34mexp=> BEGIN ISOLATION LEVEL SERIALIZABLE;\u001b[0m"]
[2.25, "o", "\u001b[4;1H\u001b[1;32mBEGIN\u001b[0m"]
