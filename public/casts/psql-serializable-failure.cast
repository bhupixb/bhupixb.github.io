[7.25, "o", "\u001b[3;57H\u001b[1;34mexp=> BEGIN ISOLATION LEVEL SERIALIZABLE;\u001b[0m"]
[8.25, "o", "\u001b[4;57H\u001b[1;32mBEGIN\u001b[0m"]
[9.25, "o", "\u001b[5;57H\u001b[1;34mexp=*> SELECT * FROM accounts\u001b[0m"]
[9.5, "o", "\u001b[6;57H\u001b[1;34m       WHERE name = 'user-2';\u001b[0m"]
