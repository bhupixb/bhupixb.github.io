[11.25, "o", "\u001b[11;57H\u001b[0m(1 row)\u001b[0m"]
[13.25, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;1H\u001b[1;36mSESSION 1\u001b[0m\u001b[1;57H\u001b[1;35mSESSION 2\u001b[0m\u001b[2;1H\u001b[0m------------------------------------------------------\u001b[0m\u001b[2;57H\u001b[0m------------------------------------------------------\u001b[0m\u001b[2;55H\u2502\u001b[3;55H\u2502\u001b[4;55H\u2502\u001b[5;55H\u2502\u001b[6;55H\u2502\u001b[7;55H\u2502\u001b[8;55H\u2502\u001b[9;55H\u2502\u001b[10;55H\u2502\u001b[11;55H\u2502\u001b[12;55H\u2502\u001b[13;55H\u2502\u001b[14;1H\u001b[1;33mDifferent names; both scans hold table SIReadLocks.\u001b[0m"]
[14.25, "o", "\u001b[3;1H\u001b[1;34mexp=*> UPDATE accounts\u001b[0m"]
[14.5, "o", "\u001b[4;1H\u001b[1;34m       SET balance = 111\u001b[0m"]
[14.75, "o", "\u001b[5;1H\u001b[1;34m       WHERE id = 1;\u001b[0m"]
[15.75, "o", "\u001b[6;1H\u001b[1;32mUPDATE 1\u001b[0m"]
[16.75, "o", "\u001b[3;57H\u001b[1;34mexp=*> UPDATE accounts\u001b[0m"]
[17.0, "o", "\u001b[4;57H\u001b[1;34m       SET balance = 123\u001b[0m"]
[17.25, "o", "\u001b[5;57H\u001b[1;34m       WHERE id = 2;\u001b[0m"]
[18.25, "o", "\u001b[6;57H\u001b[1;32mUPDATE 1\u001b[0m"]
[19.25, "o", "\u001b[14;1H\u001b[1;33mBoth updates complete without waiting.                \u001b[0m"]
[20.75, "o", "\u001b[8;1H\u001b[1;34mexp=*> COMMIT;\u001b[0m"]
[21.75, "o", "\u001b[9;1H\u001b[1;32mCOMMIT\u001b[0m"]
[23.25, "o", "\u001b[8;57H\u001b[1;34mexp=*> COMMIT;\u001b[0m"]
[24.25, "o", "\u001b[9;57H\u001b[1;31mERROR: could not serialize access due to\u001b[0m"]
[24.5, "o", "\u001b[10;57H\u001b[1;31mread/write dependencies among transactions\u001b[0m"]
[24.75, "o", "\u001b[11;57H\u001b[1;31mDETAIL: Canceled on identification as a pivot,\u001b[0m"]
[25.0, "o", "\u001b[12;57H\u001b[1;31mduring commit attempt.\u001b[0m"]
[25.25, "o", "\u001b[13;57H\u001b[1;33mHINT: The transaction might succeed if retried.\u001b[0m"]
[28.25, "o", "\u001b[14;1H\u001b[1;33mSession 1 commits; Session 2 must retry.              \u001b[0m"]
